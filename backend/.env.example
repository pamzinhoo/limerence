# Ambiente: development | production
ENVIRONMENT=development

# PostgreSQL (formato SQLAlchemy async) — mesmo banco usado hoje pelo bot/
# durante a migracao (Fase 1-5); a cadeia de migrations e a mesma, so passa
# a ser aplicada por aqui.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_limerence

# Logging
LOG_LEVEL=INFO

# --- Redis (rate limiter compartilhado entre instancias) -----------------

# Obrigatorio quando ENVIRONMENT=production (Settings.load() recusa subir
# sem isso). Sem Redis, o rate limiter cai pro RateLimiter em memoria de
# sempre — funciona numa instancia so, mas nao e compartilhado entre
# workers/instancias (cada processo aplica o limite separado). Device Flow
# (AuthService._pending_logins) ainda NAO usa Redis (continua em memoria,
# CODE BLOCKER documentado em docs/migracao-bot-backend.md).
REDIS_URL=

# --- API HTTP ------------------------------------------------------------

API_HOST=127.0.0.1
# Porta diferente da do bot (8000) de proposito: durante a migracao os dois
# processos rodam em paralelo (ver Fase 4 do plano de migracao).
API_PORT=8001

# URL publica que o gateway/Launcher usa pra chamar de volta (webhook, OAuth
# callback). Em dev local sem dominio, deixe o default — webhook nao vai
# chegar ate voce expor essa porta (ex: ngrok) ou apontar um dominio real.
PUBLIC_BASE_URL=http://localhost:8001

# --- Monetizacao / Gateway de pagamentos ---------------------------------

WEBHOOK_ENABLED=false
PAYMENT_MODE=sandbox

MERCADOPAGO_ACCESS_TOKEN_SANDBOX=
MERCADOPAGO_PUBLIC_KEY_SANDBOX=
MERCADOPAGO_WEBHOOK_SECRET_SANDBOX=

MERCADOPAGO_ACCESS_TOKEN_PRODUCTION=
MERCADOPAGO_PUBLIC_KEY_PRODUCTION=
MERCADOPAGO_WEBHOOK_SECRET_PRODUCTION=

# --- Storage (download de DLC/base game/binario do Launcher) ------------

STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_DOWNLOAD_TTL_SECONDS=600

# --- Canal interno Backend<->Bot ------------------------------------------

# Segredo HMAC compartilhado com bot/.env (mesma variavel, mesmo valor) que
# autentica POST /internal/* e qualquer chamada Bot -> Backend. Minimo 32
# bytes (HS256, RFC 7518 3.2) — abaixo disso Settings.load() recusa subir.
INTERNAL_API_SECRET=

# Base URL do bot (porta 8000 por padrao) — usada pelo InternalEventsClient
# pra notificar eventos (ex.: POST /internal/license-events). Sem isso,
# LicenseService fica sem publicar eventos, mesmo com INTERNAL_API_SECRET
# configurado.
BOT_INTERNAL_BASE_URL=http://127.0.0.1:8000
INTERNAL_EVENTS_TIMEOUT_SECONDS=5

# --- Autenticacao (Discord OAuth + JWT) -----------------------------------

DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

JWT_SECRET_KEY=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ------------------------------------------------------------------

# Vazio (default) = nega toda origem — correto pra API consumida por Bearer
# token (Launcher/Tauri), nao por navegador/cookie. So preencha se algum
# frontend web (ex.: painel staff) for chamar esta API direto do navegador.
# Lista separada por virgula: https://a.example.com,https://b.example.com
CORS_ALLOWED_ORIGINS=
