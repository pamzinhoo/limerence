# Backend (FastAPI, porta 8001 por padrao) — Fase Final da migracao
# bot -> backend: o Launcher fala com o Backend, nunca mais com o Bot.
# Nome novo/documentado; LIMERENCE_API_BASE_URL (nome antigo, apontava pro
# Bot :8000) continua aceito por compatibilidade, mesma prioridade.
BACKEND_BASE_URL=http://127.0.0.1:8001

# Caminho do executavel do jogo instalado localmente.
LIMERENCE_GAME_EXECUTABLE=

# UUID do product_id do jogo base (Products/Licenses no Backend).
LIMERENCE_BASE_GAME_PRODUCT_ID=

# Diretorio de conteudo/DLCs instalados localmente (opcional).
LIMERENCE_CONTENT_DIR=
