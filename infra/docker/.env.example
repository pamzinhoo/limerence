# Variáveis usadas pelo docker-compose.yml em si (nomes de serviço, credenciais
# do Postgres/Redis do stack). Copie pra infra/docker/.env (NUNCA commitar o
# .env real — ver .gitignore) e preencha com valores fortes gerados, nunca
# reaproveitados de outro ambiente.
#
# As variáveis de negócio (JWT_SECRET_KEY, DISCORD_OAUTH_*, MERCADOPAGO_*,
# STORAGE_*, INTERNAL_API_SECRET etc.) NÃO ficam aqui — continuam em
# backend/.env e bot/.env (ou backend/.env.staging / bot/.env.staging pro
# override de staging), como sempre.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=limerence
POSTGRES_PASSWORD=
POSTGRES_DB=bot_limerence

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=
